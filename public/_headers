# STAGING GUARD — brianmueller.org
# Cloudflare injects a managed robots.txt that begins with "User-agent: * / Allow: /",
# which can override the Disallow in our own robots.txt. This header cannot be overridden
# and is the guard that actually keeps the staging site out of search results.
# REMOVE THIS FILE AT CUTOVER, and not before.
/*
  X-Robots-Tag: noindex, nofollow

# Fonts are self-hosted and their filenames are stable, so they are renamed
# (not overwritten) if they are ever regenerated. Safe to cache hard.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Astro emits bundled CSS under /_astro/ with a content hash in the filename,
# so a changed stylesheet gets a new URL and can never be served stale.
# Do not add a long cache to any un-hashed asset path — that bug shipped once
# already and left a browser rendering new HTML against an old stylesheet.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Artwork. Filenames encode the rendered width and the art itself does not
# change without a new file, so a week of browser cache is safe. It is NOT
# marked immutable and the window is deliberately short, because these paths
# carry no content hash: replacing a picture in place means some visitors see
# the old one for up to seven days. Rename instead of overwriting.
/img/*
  Cache-Control: public, max-age=604800

/covers/*
  Cache-Control: public, max-age=604800
