# ===========================================================================
# response headers — shared by production (www.brianmueller.com) and the staging Worker
#
# One block per path, because Cloudflare merges repeated blocks silently and a
# duplicated path is how a rule ends up quietly overridden. Keep it that way.
#
# Order below: the staging guard first, then security, then caching.
# ===========================================================================


# --- STAGING GUARD ---------------------------------------------------------
# There is no X-Robots-Tag line in this file, and there must not be one.
# tools/generate-seo.mjs injects it after the build whenever SITE_ENV is not
# production, and tools/check-build.mjs fails the build if the artifact and the
# environment disagree. Nothing here has to be remembered or removed by hand at
# cutover; `npm run build:production` is the whole switch.
#
# Why a header rather than robots.txt: a Disallow asks a crawler not to fetch a
# page, which also means it never sees a noindex on that page, and a disallowed
# URL can still be listed from an external link. The header is a directive that
# travels with every response, including 404s and assets.
# --- SECURITY --------------------------------------------------------------
# The policy below is written from an inventory of what this site actually
# loads, not copied from a template. It is static files with no server
# endpoints and no forms. Every stylesheet, font and image is same-origin.
# There is exactly one third-party subresource, named below. That is why this
# can start at default-src 'none' and name only what really loads.
#
# script-src is five SHA-256 hashes plus one host. The hashes are the pre-paint
# theme read, the theme toggle, the home page's legacy-fragment handler, the
# Cookie Policy's theme reset, and the mail-link assembler. The legacy-fragment
# one is on the home page only, and its hash covers the fragment table baked
# into it, so ADDING A LEGACY FRAGMENT CHANGES THE HASH.
# There is no 'unsafe-inline'. CHANGING EITHER SCRIPT BY ONE BYTE CHANGES ITS
# HASH AND THE BROWSER WILL SILENTLY REFUSE TO RUN IT. The build still
# succeeds and the page still looks right; the only symptom is a dead theme
# button. Regenerate with:
#   npm run build && python3 tools/csp-hashes.py
#
# The host is static.cloudflareinsights.com. The beacon does NOT report to
# cloudflareinsights.com - measured on the live origin, it POSTs to
# /cdn-cgi/rum on THIS site's own hostname, which Cloudflare answers at the
# edge. That is why connect-src is 'self' and not a third-party host, and why
# it must stay 'self' rather than a literal origin: this file is shared by beta
# and production, which have different hostnames. 'self' is still tight here,
# because the site itself makes no fetch or XHR of any kind. This is Cloudflare Web
# Analytics, which the zone injects into every HTML response by itself — it is
# not in this repository and it will reappear on any hostname where the zone
# setting is on. It was blocked here until 2026-09-18, which is why nothing was
# collected before that date. Allowing it is a deliberate decision (D-21): if
# it is ever switched back off, REMOVE BOTH SOURCES AND FIX THE POLICY PAGES,
# because the privacy and cookie policies now describe a running beacon. The
# pages that must agree are src/pages/privacy-policy.astro and
# src/pages/cookies-policy.astro.
#
# style-src is 'self' with no 'unsafe-inline'. That is only possible because
# the site's nine inline style="" attributes were moved into utility classes in
# base.css. Adding one back re-opens the hole AND breaks that element.
#
# form-action 'none' and base-uri 'none' are real controls here, not padding:
# there is no form on this site and no <base> tag, so either one appearing is
# by definition an injection.
#
# Verified under enforcement: 29 pages x 2 themes, zero violations, zero
# console errors, theme script ran and webfonts loaded on all 58 loads. Seven
# negative probes (injected inline script, off-origin script, style attribute
# set from script, off-origin image, cross-origin fetch, off-site form submit,
# injected <base>) were all blocked.
#
# NOT SET, deliberately: Strict-Transport-Security. HSTS must wait until
# HTTP-to-HTTPS is actually on and every hostname that will serve this site is
# covered, or it locks visitors out of a host that cannot answer over TLS.
# See docs/site-audit/decisions.md D-12.
/*
  Content-Security-Policy: default-src 'none'; script-src 'sha256-ReSDczqo9O4scYD5ybiApwi8nuYRL7TmsLCxHhxUqKA=' 'sha256-mewFM0LyLvulgC/AqvToLhLD2XG6t/L2rs/PivEYzQY=' 'sha256-1zyjjWDFAyDpeeGeNNAHnd9dWi1Og24f1aT9m8C7y2I=' 'sha256-S49WUIOFMKIF0xKnDAB2hQ5zXvQOgW8dBNU7hV7Du+M=' 'sha256-VwCWEX/V+QUBCeRso12d4twoUJs/Lw6vkulxjZM1JFE=' https://static.cloudflareinsights.com; connect-src 'self'; manifest-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), publickey-credentials-get=(), screen-wake-lock=(), usb=(), xr-spatial-tracking=()
  Cross-Origin-Opener-Policy: same-origin


# --- CACHING AND CROSS-ORIGIN USE ------------------------------------------
# Astro emits the bundled CSS under /_astro/ with a content hash in the
# filename, so a changed stylesheet gets a new URL and can never be served
# stale. Fonts carry a -vN suffix for the same reason and are renamed, never
# overwritten, when regenerated.
#
# A long cache belongs ONLY on a path whose filename changes with its content.
# That bug shipped once already on this project and left a browser rendering
# new HTML against an old stylesheet.
#
# Cross-Origin-Resource-Policy means two different things here. On the
# stylesheet and the fonts, same-origin stops another website spending Brian's
# bandwidth to render its own pages. On the artwork the same setting would also
# stop Illuman, Choosing Presence or a reviewer from embedding a book cover,
# which is the opposite of what a publishing site wants — so those are
# cross-origin on purpose.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: same-origin

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: same-origin

# Artwork filenames encode the rendered width and the art does not change
# without a new file, so a week of browser cache is safe. Deliberately NOT
# immutable and deliberately short, because these paths carry no content hash:
# replacing a picture in place means some visitors see the old one for up to
# seven days. Rename instead of overwriting.
/img/*
  Cache-Control: public, max-age=604800
  Cross-Origin-Resource-Policy: cross-origin

/covers/*
  Cache-Control: public, max-age=604800
  Cross-Origin-Resource-Policy: cross-origin
