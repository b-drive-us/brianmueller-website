---
import '../styles/fonts.css';
import '../styles/base.css';
const { title = "Brian J. Mueller", description = "Poet. Twelve collections of poetry, and a men's writing retreat each January." } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const nav = [
  { href: "/books",   label: "Books" },
  { href: "/poems",   label: "Poems" },
  { href: "/blog",    label: "Writing" },
  { href: "/retreat", label: "Retreat" },
  { href: "/about",   label: "About" },
  { href: "/contact", label: "Contact" },
];
const isCurrent = (href) => path === href || path.startsWith(href + "/");
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- STAGING: remove this line at cutover, not before. -->
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      // Runs before first paint so a chosen theme never flashes the wrong one.
      (function () {
        try {
          var t = localStorage.getItem("theme");
          if (t === "light" || t === "dark") document.documentElement.setAttribute("data-theme", t);
        } catch (e) {}
      })();
    </script>
    <link rel="preload" href="/fonts/newsreader-normal-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/archivo-normal-latin.woff2" as="font" type="font/woff2" crossorigin />

  </head>
  <body>
    <header class="site-head">
      <div class="wrap bar">
        <a class="wordmark" href="/">Brian<span>Mueller</span></a>
        <nav class="nav" aria-label="Main">
          {nav.map((n) => (
            <a href={n.href} aria-current={isCurrent(n.href) ? "page" : undefined}>{n.label}</a>
          ))}
          <button id="theme-toggle" class="theme-toggle" type="button" aria-pressed="false">
            <span class="tt-icon" aria-hidden="true"></span>
            <span class="tt-label">Dark</span>
          </button>
        </nav>
      </div>
    </header>

    <main id="main"><slot /></main>

    <footer class="site-foot">
      <div class="wrap stack stack-l">
        <div class="cols">
          <div class="stack stack-s" style="max-width:22rem">
            <div class="wordmark">Brian<span>Mueller</span></div>
            <p class="small">Experience the Power of a Poem.™ Twelve collections of poetry, and a
               men's writing retreat each January in Ohio.</p>
          </div>
          <div class="stack stack-s">
            <div class="eyebrow">Elsewhere</div>
            <div class="foot-links" style="flex-direction:column">
              <a href="https://brianspoems.com">Read the poems</a>
              <a href="https://www.amazon.com/stores/Brian-J.-Mueller/author/B00JQMV412">Books on Amazon</a>
              <a href="/retreat">Rooted in the Land</a>
            </div>
          </div>
        </div>
        <div class="foot-links">
          <a href="/faq">Questions</a>
          <a href="/privacy-policy">Privacy</a>
          <a href="/terms-conditions">Terms</a>
          <a href="/cookies-policy">Cookies</a>
          <a href="/disclaimer">Disclaimer</a>
        </div>
        <p class="small">Poems licensed CC BY-NC-ND 4.0 — attribute, don't sell, don't change.
           Some book links are Amazon Associate links; a purchase may earn a small commission at
           no cost to you.</p>
      </div>
    </footer>
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var btn = document.getElementById("theme-toggle");
        if (!btn) return;
        var label = btn.querySelector(".tt-label");
        var media = window.matchMedia("(prefers-color-scheme: dark)");

        function current() {
          var set = root.getAttribute("data-theme");
          return set === "light" || set === "dark" ? set : (media.matches ? "dark" : "light");
        }
        function paint() {
          var now = current();
          // The button says what it will switch you TO, which is what people read it as.
          var next = now === "dark" ? "light" : "dark";
          label.textContent = next === "dark" ? "Dark" : "Light";
          btn.setAttribute("aria-pressed", now === "dark" ? "true" : "false");
          btn.setAttribute("aria-label", "Switch to " + next + " mode");
          btn.dataset.mode = now;
        }
        btn.addEventListener("click", function () {
          var next = current() === "dark" ? "light" : "dark";
          root.setAttribute("data-theme", next);
          try { localStorage.setItem("theme", next); } catch (e) {}
          paint();
        });
        // Follow the system only while no explicit choice has been stored.
        media.addEventListener("change", function () {
          if (!root.hasAttribute("data-theme")) paint();
        });
        paint();
      })();
    </script>
  </body>
</html>
