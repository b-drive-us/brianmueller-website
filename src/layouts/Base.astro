---
import '../styles/fonts.css';
import '../styles/base.css';
import { site, absolute, NON_INDEXABLE_PATHS } from '../site.config.mjs';

// Replaced at build time by astro.config.mjs from package.json.
const VERSION = __SITE_VERSION__;

const {
  title = "Brian J. Mueller",
  description = "Poet. Twelve collections of poetry, and a men's writing retreat each January.",
  // Social preview. Defaults to the site card; a page passes its own when it has
  // a better one. Every option must be a real 1200x630 file in public/img.
  ogImage = "/img/og-default-1200x630.jpg",
  ogImageAlt = "A bull in a shaft of sunlight in a darkened ring, facing a raised red cape.",
  ogType = "website",
} = Astro.props;

// `build.format: "file"` makes Astro.url.pathname carry the .html extension
// ("/books.html"), but Cloudflare 307s /books.html to /books, and every link,
// nav item and legacy redirect on this site uses the extensionless form. A
// canonical pointing at a URL that redirects is worse than no canonical at all,
// so normalise to the URL the server actually serves.
const path = Astro.url.pathname
  .replace(/index\.html$/, "")
  .replace(/\.html$/, "")
  .replace(/\/$/, "") || "/";

// Canonical is built from the environment's origin and this page's own path.
// It is never derived from a request header - see src/site.config.mjs.
const canonical = absolute(path);

// Indexing is a property of the environment, not of the template. Beta and
// preview are excluded; 404 is excluded everywhere because a soft-404 in the
// index is worse than no result at all.
const indexable = site.indexable && !NON_INDEXABLE_PATHS.has(path);

const ogImageUrl = absolute(ogImage);
const nav = [
  { href: "/books",   label: "Books" },
  { href: "/poems",   label: "Poems" },
  { href: "/blog",    label: "Notes" },
  { href: "/retreat", label: "Retreat" },
  { href: "/about",   label: "About" },
  { href: "/contact", label: "Contact" },
];
const isCurrent = (href) => path === href || path.startsWith(href + "/");
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={canonical} />

    {/* Indexing follows the build environment. There is no hand-edited staging
        line to remember to remove: `npm run build:production` turns this off and
        tools/check-build.mjs fails the build if the artifact disagrees. */}
    {!indexable && <meta name="robots" content="noindex, nofollow" />}

    {/* Icons. There were none at all until 1.1.0, so every first visit made a
        404 request for /favicon.ico and every tab and bookmark showed a blank
        page icon (M07). The SVG is the site's own Newsreader B and carries its
        own dark-mode rule; the .ico is the fallback for browsers that ignore
        SVG icons; the touch icon is opaque because iOS composites alpha on
        black. The manifest needs `manifest-src 'self'` in the CSP - it falls
        back to default-src, which is 'none'.

        The SVG carries its colours as presentation attributes, not a <style>
        block. style-src is 'self' with no 'unsafe-inline', so an inline
        stylesheet inside an SVG document is refused - and a refused stylesheet
        means fill defaults to black, which renders a black B on a black tile.
        Caught by rendering it under the real policy, not by reading it. */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#F7F4EF" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1B1714" media="(prefers-color-scheme: dark)" />

    {/* The build's own version, from package.json. One request answers "what
        is live?" - which matters for a rollback, and will matter more once
        payments are involved. tools/check-build.mjs enforces that it matches. */}
    <meta name="version" content={VERSION} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Brian J. Mueller" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <script is:inline>
      // Runs before first paint so a chosen theme never flashes the wrong one.
      (function () {
        try {
          var t = localStorage.getItem("theme");
          if (t === "light" || t === "dark") document.documentElement.setAttribute("data-theme", t);
        } catch (e) {}
      })();
    </script>
    <link rel="preload" href="/fonts/newsreader-normal-latin-v2.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/archivo-normal-latin-v2.woff2" as="font" type="font/woff2" crossorigin />

  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-head">
      <div class="wrap bar">
        <a class="wordmark" href="/">Brian<span>Mueller</span></a>
        <nav class="nav" aria-label="Main">
          {nav.map((n) => (
            <a href={n.href} aria-current={isCurrent(n.href) ? "page" : undefined}>{n.label}</a>
          ))}
        </nav>
        <!-- Outside <nav>: a theme control is not navigation, and as a direct child
             of .bar it can be placed on the phone header's first row. -->
        <button id="theme-toggle" class="theme-toggle" type="button" aria-pressed="false">
          <span class="tt-icon" aria-hidden="true"></span>
          <span class="tt-label">Dark</span>
        </button>
      </div>
    </header>

    <main id="main" tabindex="-1"><slot /></main>

    <footer class="site-foot">
      <div class="wrap stack stack-l">
        <div class="cols">
          <div class="stack stack-s u-measure-22">
            <div class="wordmark">Brian<span>Mueller</span></div>
            <p class="small">Experience the Power of a Poem.™ Twelve collections of poetry, and a
               men's writing retreat each January in Ohio.</p>
          </div>
          <div class="stack stack-s">
            <div class="eyebrow">Elsewhere</div>
            <div class="foot-links u-col">
              <a href="https://brianspoems.com">Read the poems</a>
              <a href="https://www.amazon.com/stores/Brian-J.-Mueller/author/B00JQMV412">Books on Amazon</a>
              <a href="/retreat">Rooted in the Land</a>
            </div>
          </div>
        </div>
        <div class="foot-links">
          <a href="/faq">Questions</a>
          <a href="/privacy-policy">Privacy</a>
          <a href="/terms-conditions">Terms</a>
          <a href="/cookies-policy">Cookies</a>
          <a href="/disclaimer">Disclaimer</a>
        </div>
        <p class="small">Poems licensed CC BY-NC-ND 4.0 — attribute, don't sell, don't change.
           Some book links are Amazon Associate links; a purchase may earn a small commission at
           no cost to you.</p>
      </div>
    </footer>
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var btn = document.getElementById("theme-toggle");
        if (!btn) return;
        var label = btn.querySelector(".tt-label");
        var media = window.matchMedia("(prefers-color-scheme: dark)");

        function current() {
          var set = root.getAttribute("data-theme");
          return set === "light" || set === "dark" ? set : (media.matches ? "dark" : "light");
        }
        function paint() {
          var now = current();
          // The button says what it will switch you TO, which is what people read it as.
          var next = now === "dark" ? "light" : "dark";
          label.textContent = next === "dark" ? "Dark" : "Light";
          btn.setAttribute("aria-pressed", now === "dark" ? "true" : "false");
          btn.setAttribute("aria-label", "Switch to " + next + " mode");
          btn.dataset.mode = now;
        }
        btn.addEventListener("click", function () {
          var next = current() === "dark" ? "light" : "dark";
          root.setAttribute("data-theme", next);
          try { localStorage.setItem("theme", next); } catch (e) {}
          paint();
          // Anything on the page that reports what is stored needs to hear this,
          // or it keeps describing the state from before the click. The Cookie
          // Policy's reset control does exactly that.
          document.dispatchEvent(new Event("themechanged"));
        });
        // Follow the system only while no explicit choice has been stored.
        media.addEventListener("change", function () {
          if (!root.hasAttribute("data-theme")) paint();
        });
        // The Cookie Policy carries a control that clears the stored preference.
        // It announces itself here rather than reaching into this script, so the
        // two stay independent and neither depends on the other loading first.
        document.addEventListener("themecleared", paint);
        paint();
      })();
    </script>
  </body>
</html>
