---
// Renders a poem with a true hanging indent: each line is its own block, so a line
// that is too long for the measure wraps and its continuation hangs indented.
// A blank line becomes a stanza break.
// Two named props and nothing else. This used to gather `{...rest}` and spread
// it onto the div, which is the pattern behind repeated Astro advisories about
// unescaped attribute NAMES (GHSA-jrpj-wcv7-9fh9, GHSA-f48w-9m4c-m7f5).
// Nothing here was reachable - every call site is a page in this repo, not
// visitor input - but the spread carried exactly one inline style, which is now
// a class, so the pattern is simply gone.
const { text, class: cls = "" } = Astro.props;
const lines = String(text).replace(/\r\n?/g, "\n").split("\n");
---
<div class={`poem ${cls}`}>
  {lines.map(l => (l.trim() === "" ? <span class="pl br"></span> : <span class="pl">{l}</span>))}
</div>
