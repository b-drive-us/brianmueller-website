---
import Base from '../layouts/Base.astro';
---
<Base title="Not found — Brian J. Mueller" description="That page isn't here.">
  <section class="wrap stack stack-l">
    <div class="stack stack-m prose">
      <div class="eyebrow">404</div>
      <h1>That page isn't here.</h1>
      <hr class="rule-short" />
      <p class="lede">It may have moved when the site was rebuilt, or it may never have existed.
         Either way, here's the way back in.</p>
      <div class="btn-row">
        <a class="btn" href="/books">The books</a>
        <a class="btn btn-ghost" href="https://brianspoems.com">Read the poems</a>
      </div>
      <p class="small">Looking for a particular poem? Nearly all of them live at
         <a href="https://brianspoems.com">brianspoems.com</a>. If you can't find what you came for,
         <a href="/contact">write to me</a> and I'll point you at it.</p>
    </div>
  </section>
</Base>
