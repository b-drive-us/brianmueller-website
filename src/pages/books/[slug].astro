---
import Base from '../../layouts/Base.astro';
import Poem from '../../components/Poem.astro';
import books from '../../data/books.json';
import series from '../../data/series.json';

export function getStaticPaths() {
  return books.map(b => ({ params: { slug: b.slug }, props: { book: b } }));
}
const { book } = Astro.props;
const s = series.find(x => x.slug === book.series);
const siblings = book.series
  ? books.filter(b => b.series === book.series).sort((a,b) => a.position - b.position)
  : [];
const collects = (book.collects || []).map(sl => books.find(b => b.slug === sl)).filter(Boolean);
const kindLabel = { collection: null, anthology: "Anthology", "multi-author": "Many voices" }[book.kind];
const c = book.cover;
---
<Base title={`${book.title} — Brian J. Mueller`} description={book.blurb.slice(0,150)}>
  <section class="wrap">
    <div class="book-lead">
      <figure class="cover cover-lg">
        <img src={`${c.src}-640.webp`} srcset={`${c.src}-320.webp 320w, ${c.src}-640.webp 640w`}
             sizes="(max-width: 800px) 60vw, 22rem"
             width={c.w} height={c.h} alt={`Front cover of ${book.title}`} />
      </figure>

      <div class="stack stack-l">
        <div class="stack stack-m">
          {s && <div class="eyebrow"><a href={`/series/${s.slug}`} style="color:inherit">{s.name}</a> · {book.position} of {siblings.length}</div>}
          {!s && <div class="eyebrow">Standalone</div>}
          <h1>{book.title}</h1>
          <p class="lede serif-italic">{book.subtitle}</p>
          {kindLabel && <div><span class="badge">{kindLabel}</span></div>}
          <hr class="rule-short" />
        </div>

        {book.epigraph && <Poem text={book.epigraph} class="poem-left" />}

        <div class="stack stack-m">
          <p>{book.blurb}</p>
          {book.quote && (
            <blockquote class="pull">{book.quote}<cite>— {book.quoteBy}</cite></blockquote>
          )}
          <div class="btn-row"><a class="btn" href={book.buy} rel="sponsored nofollow">Buy on Amazon</a></div>
        </div>

        {collects.length > 0 && (
          <div class="notice">
            <b>This volume collects three earlier books.</b> If you already own
            {" "}{collects.map((c2,i) => (<span>{i > 0 ? (i === collects.length-1 ? " and " : ", ") : " "}<a href={`/books/${c2.slug}`}>{c2.title}</a></span>))},
            you have everything inside it.
          </div>
        )}

        {book.occasion && <p class="small occasion">{book.occasion}</p>}

        <dl class="colophon">
          {book.year && <div><dt>Published</dt><dd>{book.year}</dd></div>}
          {book.pages && <div><dt>Pages</dt><dd>{book.pages}</dd></div>}
          <div><dt>Publisher</dt><dd>{book.publisher}</dd></div>
          {book.isbn13 && <div><dt>ISBN</dt><dd>{book.isbn13}</dd></div>}
        </dl>
        {book.published && <p class="small">Published {book.published}.</p>}
        {book.isbnNote && <p class="small">{book.isbnNote}</p>}

        {book.kind === "multi-author" && (
          <div class="notice">
            <b>These poems are not mine alone.</b> They were written by the men who came to the
            retreat, in council circle, and read aloud to one another. The retreat continues each
            January as <a href="/retreat">Rooted in the Land</a>.
          </div>
        )}
      </div>
    </div>

    {siblings.length > 1 && (
      <div class="stack stack-m" style="margin-top:clamp(3rem,6vw,4.5rem)">
        <h2>{s.name}</h2>
        <div class="book-grid">
          {siblings.map(b => (
            <a class={"book-card" + (b.slug === book.slug ? " is-here" : "")} href={`/books/${b.slug}`}>
              <figure class="cover">
                <img src={`${b.cover.src}-200.webp`} srcset={`${b.cover.src}-200.webp 200w, ${b.cover.src}-320.webp 320w`}
                       sizes="84px" width={b.cover.w} height={b.cover.h}
                     loading="lazy" alt="" />
              </figure>
              <div class="bc-text">
                <div class="m">{b.position} of {siblings.length}{b.slug === book.slug ? " · you are here" : ""}</div>
                <div class="t">{b.title}</div>
                <div class="s">{b.subtitle}</div>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}
  </section>
</Base>
