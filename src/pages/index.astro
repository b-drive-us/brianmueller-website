---
import Base from '../layouts/Base.astro';
import Poem from '../components/Poem.astro';
import books from '../data/books.json';
import series from '../data/series.json';
import poems from '../data/poems.json';
import { getCollection } from 'astro:content';

const newest = books.find(b => b.slug === 'trust-stillness');
const alsoNew = books.filter(b => b.featured && b.slug !== 'trust-stillness');
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const latest = posts[0];
const fmt = (d) => d.toLocaleDateString('en-US', { year:'numeric', month:'long', day:'numeric', timeZone:'UTC' });
const taste = poems.find(p => p.slug === 'tomorrow-could-be-wonderful');
---
<Base title="Brian J. Mueller — Poet">
  <section class="wrap">
    <div class="stack stack-m prose">
      <div class="eyebrow">Poet</div>
      <h1>Trust the first line.</h1>
      <hr class="rule-short" />
      <p class="lede">I write poems for everyone.</p>
      <p>My journey with poetry began between college lectures, but it truly took flight through
         the rhythm of my favourite songs and the landscapes of my travels. In 2002 I published my
         debut collection, <em>Bull Head</em>. Eleven volumes have followed.</p>
      <p>I believe poetry is the language of the soul. It offers the depth and meaning we often
         crave, stirring our passions while anchoring us in the intuitive truth that there is
         always more to life than meets the eye.</p>
      <div class="btn-row" style="padding-top:.6rem">
        <a class="btn" href="/poems">Read a few poems</a>
        <a class="btn btn-ghost" href="/books">See the books</a>
      </div>
    </div>
  </section>

  {newest && (
    <section class="wrap" style="border-top:1px solid var(--rule)">
      <div class="feature">
        <a class="cover" href={`/books/${newest.slug}`}>
          <img src={`${newest.cover.src}-640.webp`}
               srcset={`${newest.cover.src}-320.webp 320w, ${newest.cover.src}-640.webp 640w`}
               sizes="(max-width: 800px) 55vw, 18rem"
               width={newest.cover.w} height={newest.cover.h}
               alt={`Front cover of ${newest.title}`} />
        </a>
        <div class="stack stack-m">
          <div class="eyebrow">The new book · {newest.year}</div>
          <h2>{newest.title}</h2>
          <p class="lede serif-italic">{newest.subtitle}</p>
          {newest.epigraph && <Poem text={newest.epigraph} class="poem-left" style="font-size:1.05rem" />}
          <div class="btn-row">
            <a class="btn" href={newest.buy} rel="sponsored nofollow">Buy on Amazon</a>
            <a class="btn btn-ghost" href={`/books/${newest.slug}`}>More about it</a>
          </div>
        </div>
      </div>
    </section>
  )}

  {taste && (
    <section class="wrap" style="border-top:1px solid var(--rule)">
      <div class="stack stack-m" style="max-width:34rem">
        <div class="eyebrow">A poem</div>
        <h2>{taste.title}</h2>
        <Poem text={taste.text} class="poem-left" />
        <p class="poem-source">from <a href={`/books/${taste.slug}`}>{books.find(b=>b.slug===taste.slug).title}</a></p>
        <div class="btn-row">
          <a class="btn btn-ghost" href="/poems">Ten more like it</a>
          <a class="btn btn-ghost" href="https://brianspoems.com">All 1,832 at Brian's Poems</a>
        </div>
      </div>
    </section>
  )}

  <section class="wrap stack stack-l" style="border-top:1px solid var(--rule)">
    <div class="stack stack-s">
      <div class="eyebrow">Series</div>
      <h2>Three bodies of work</h2>
      <p class="lede prose">Every book stands on its own. These are the threads that run between them.</p>
    </div>
    <div class="book-grid">
      {series.map(s => (
        <a class="book-card" href={`/series/${s.slug}`}>
          <div class="bc-text">
            <div class="t">{s.name}</div>
            <div class="s">{s.tagline}</div>
            <div class="m">{books.filter(b => b.series === s.slug).length} volumes →</div>
          </div>
        </a>
      ))}
      {alsoNew.map(b => (
        <a class="book-card" href={`/books/${b.slug}`}>
          <figure class="cover">
            <img src={`${b.cover.src}-200.webp`} width={b.cover.w} height={b.cover.h}
                 loading="lazy" alt="" />
          </figure>
          <div class="bc-text">
            <div class="m">Standalone{b.year ? ` · ${b.year}` : ""}</div>
            <div class="t">{b.title}</div>
            <div class="s">{b.subtitle}</div>
          </div>
        </a>
      ))}
    </div>
  </section>

  {latest && (
    <section class="wrap" style="border-top:1px solid var(--rule)">
      <div class="stack stack-m prose">
        <div class="eyebrow">Latest note · {fmt(latest.data.date)}</div>
        <h2><a href={`/blog/${latest.id}`} style="color:inherit;text-decoration:none">{latest.data.title}</a></h2>
        <p>{latest.data.summary}</p>
        <div class="btn-row"><a class="btn btn-ghost" href={`/blog/${latest.id}`}>Read it</a></div>
      </div>
    </section>
  )}

  <section class="wrap" style="border-top:1px solid var(--rule)">
    <div class="stack stack-m prose">
      <div class="eyebrow">Each January</div>
      <h2>A men's writing retreat</h2>
      <p>For five years I shared my work daily through <em>Brian's Poem of the Day</em>. That
         project blossomed into a deeper calling: a request to design a writing retreat focused on
         healing and spiritual growth for men. I have now had the privilege of co-leading this
         annual retreat for a decade.</p>
      <div class="btn-row"><a class="btn btn-ghost" href="/retreat">Rooted in the Land, January 2027</a></div>
    </div>
  </section>
</Base>
