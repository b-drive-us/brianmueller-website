---
import Base from '../../layouts/Base.astro';
import books from '../../data/books.json';
import series from '../../data/series.json';

export function getStaticPaths() {
  return series.map(s => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props;
const vols = books.filter(b => b.series === s.slug).sort((a,b) => a.position - b.position);
---
<Base title={`${s.name} — Brian J. Mueller`} description={s.tagline}>
  <section class="wrap stack stack-l">
    <div class="stack stack-m prose">
      <div class="eyebrow">Series · {vols.length} volumes</div>
      <h1>{s.name}</h1>
      <hr class="rule-short" />
      <p class="lede">{s.tagline}</p>
      <p>{s.description}</p>
    </div>
    <div class="book-grid">
      {vols.map(b => (
        <a class="book-card" href={`/books/${b.slug}`}>
          <div class="m">{b.position} of {vols.length}{b.year ? ` · ${b.year}` : ""}</div>
          <div class="t">{b.title}</div>
          <div class="s">{b.subtitle}</div>
          {b.kind !== "collection" && (
            <div style="padding-top:.4rem"><span class="badge">{b.kind === "anthology" ? "Anthology" : "Many voices"}</span></div>
          )}
        </a>
      ))}
    </div>
  </section>
</Base>
