---
import Base from '../layouts/Base.astro';
import Poem from '../components/Poem.astro';
import poems from '../data/poems.json';
import books from '../data/books.json';
const byBook = Object.fromEntries(books.map(b => [b.slug, b]));
const BSP = "https://brianspoems.com";
---
<Base title="Poems — Brian J. Mueller"
      description="Eleven poems, one from each collection. The complete searchable archive lives at brianspoems.com.">
  <section class="wrap stack stack-l">
    <div class="stack stack-m prose">
      <div class="eyebrow">A few poems</div>
      <h1>Poems</h1>
      <hr class="rule-short" />
      <p class="lede">Eleven poems, one from each book, in order of publication. Twelve books,
         eleven poems: <a href="/books/complete-bull">Complete Bull</a> is an anthology of the three
         Bull collections, so it is represented by those and not given a selection of its own.</p>
    </div>

    <div class="archive-note">
      <p><b>The whole collection is at <a href={BSP}>brianspoems.com</a>.</b> Every published
         piece is there — poems, prose and haiku — and all of it is searchable. That archive is the
         definitive source for my work. What follows is a handful, one from each book.</p>
      {/* This page is where the old /living-workshop/ poem links now land when
          the specific poem could not be identified. Nearly a thousand addresses
          point here, so it has to say something useful to a reader who followed
          one. See R01 in the September audits. */}
      <p class="small">Followed an older link to a particular poem? The blog those links pointed
         at is closed, and the poems moved to <a href={BSP}>brianspoems.com</a> — all 1,834 of
         them, searchable by title, by first line, or by the words inside the poem.</p>
      <div class="btn-row"><a class="btn" href={BSP}>Search the whole collection</a></div>
    </div>

    <div class="poem-list">
      {poems.map(p => {
        const b = byBook[p.slug];
        return (
          <article class="poem-entry">
            <header class="stack stack-s">
              <h2>{p.title}</h2>
              {p.subtitle && <p class="poem-sub">{p.subtitle}</p>}
            </header>
            <Poem text={p.text} class="poem-left" />
            <footer class="poem-source">
              from <a href={`/books/${p.slug}`}>{b.titleFull ?? b.title}</a>{b.year ? `, ${b.year}` : ""}
              {p.archive && <> · <a href={p.archive}>read it in the archive</a></>}
            </footer>
          </article>
        );
      })}
    </div>

    <div class="archive-note">
      <p>If one of these caught you, there are a great many more.
         <a href={BSP}>Brian's Poems</a> is where they all live — searchable, by title, by first
         line, by book. The <a href="/books">printed collections</a> are on Amazon.</p>
    </div>
  </section>
</Base>
