---
import Base from '../layouts/Base.astro';
---
<Base title="Poems — Brian J. Mueller">
  <section class="wrap stack stack-l">
    <div class="stack stack-m prose">
      <div class="eyebrow">Eight years, 777 poems</div>
      <h1>The poems live at Brian's Poems.</h1>
      <hr class="rule-short" />
      <p class="lede">Every poem from <em>Brian's Poem of the Day</em>, the Living Workshop, and
         the collections — searchable by title, first line, or a phrase you half remember.</p>
      <div class="btn-row"><a class="btn" href="https://brianspoems.com">Go to brianspoems.com</a></div>
      <div class="notice">
        <b>Placeholder.</b> A curated selection will sit here — a few dozen poems as a way in,
        with the full archive one click away. The 778 existing <code>/living-workshop/</code>
        URLs will redirect rather than break.
      </div>
    </div>
  </section>
</Base>
