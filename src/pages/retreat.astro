---
import Base from '../layouts/Base.astro';
---
<Base title="Rooted in the Land — a men's writing retreat">
  <section class="wrap stack stack-l">
    <div class="stack stack-m prose">
      <div class="eyebrow">January 15–17, 2027 · Bergamo Center, Dayton, Ohio</div>
      <h1>Rooted in the Land</h1>
      <p class="lede serif-italic">A men's writing retreat inspired by Wendell Berry.</p>
      <hr class="rule-short" />
      <p>A weekend of reflection, fraternity, and renewal — writing our way toward deeper
         belonging. Open to men of every writing experience, from the complete novice to the
         published author.</p>
      <div class="notice">
        <b>Registration goes here.</b> The page and the Stripe checkout are built and scheduled
        for late September. Until then this is a placeholder.
      </div>
    </div>
  </section>
</Base>
